{
  "name": "budify-global",
  "version": "1.0.0",
  "private": true,
  "description": "Budify global, compliance-aware, multi-language B2B marketing site",
  "scripts": {
    "dev": "next dev",
    "check": "node scripts/check-compliance.mjs && node scripts/check-i18n.mjs && node scripts/content-lint.mjs",
    "audit-log": "node scripts/audit-log.mjs",
    "assumptions": "node scripts/gen-assumptions.mjs",
    "fetch-images": "node scripts/fetch-sa-images.mjs",
    "prebuild": "npm run check && npm run audit-log",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "next": "15.5.27",
    "next-intl": "4.14.9",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}