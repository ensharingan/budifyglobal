# ---- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.budify.com        # TODO: set the real production domain
NEXT_PUBLIC_STATUS_URL=                            # public status page, e.g. https://status.budify.com

# ---- Indexing ---------------------------------------------------------
# Leave unset (or 0) until the pre-launch checklist is complete: the site then sends X-Robots-Tag: noindex
# and robots.txt disallows everything. Set to 1 on the production deployment to allow search engines.
ALLOW_INDEXING=0

# ---- Launch gate ------------------------------------------------------
# 1 = `npm run check` FAILS while any [TO BE COMPLETED] placeholder remains in content/entities.json
STRICT_LAUNCH=0

# ---- Analytics (loaded ONLY after consent in opt-in regions) -----------
# Choose one or none. Leave empty to ship with no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# ---- Bot protection (optional, no CAPTCHA bypass: honeypot + timing always on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Form delivery & data residency ------------------------------------
# Leads are POSTed as JSON to the webhook for the visitor's data region
# (regions come from compliance.config.json → markets.*.dataRegion).
LEAD_WEBHOOK_URL_EU=
LEAD_WEBHOOK_URL_US=
LEAD_WEBHOOK_URL_CA=
LEAD_WEBHOOK_URL_AU=
LEAD_WEBHOOK_URL_SG=
LEAD_WEBHOOK_URL_ZA=
LEAD_WEBHOOK_URL_DEFAULT=
# Optional: same idea for consent-log events
CONSENT_LOG_WEBHOOK_URL=

# ---- Newsletter double opt-in ------------------------------------------
NEWSLETTER_SECRET=change-me-long-random-string      # HMAC key for confirmation tokens
RESEND_API_KEY=
EMAIL_FROM="Budify <no-reply@budify.com>"
